#!/usr/bin/env bash
# agentssh-get <context> <remote-path> <local-file>
#
# Copy a remote file down over the audited agentssh channel, base64 on the
# wire, verified by sha256. Remote stdout streams through agentssh unmodified,
# so the download needs no chunking — only the upload direction hits the
# 128 KiB argv limit.
set -euo pipefail

usage() { echo "usage: agentssh-get <context> <remote-path> <local-file>" >&2; exit 2; }
[ $# -eq 3 ] || usage
ctx=$1 remote=$2 local=$3

sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
rq=$(sq "$remote")

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
echo "agentssh-get: $ctx:$remote -> $local" >&2

want=$(agentssh run "$ctx" -- sh -c \
  "{ sha256sum $rq 2>/dev/null || shasum -a 256 $rq; } | cut -d' ' -f1")
want=${want//[$'\r\n ']/}

agentssh run "$ctx" -- base64 -w0 "$remote" > "$tmp/payload.b64"
base64 -d "$tmp/payload.b64" > "$tmp/out"

got=$(sha256sum "$tmp/out" | cut -d' ' -f1)
if [ "$want" != "$got" ]; then
  echo "agentssh-get: CHECKSUM MISMATCH (remote $want, local $got) — not written" >&2
  exit 1
fi
mkdir -p "$(dirname "$local")"
mv "$tmp/out" "$local"
echo "agentssh-get: ok, sha256 $want" >&2
